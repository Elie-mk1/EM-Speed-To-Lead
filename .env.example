# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase -> Project Settings -> API
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> secret (service_role) key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password-protect the dashboard (leave empty to turn off)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
